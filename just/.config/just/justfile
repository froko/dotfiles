# List available commands
_index:
  @{{just_executable()}} --justfile {{justfile()}} --list

# Run a command, show output only on failure
_run-and-report cmd description:
    #!/usr/bin/env bash
    tmp=$(mktemp)
    if {{cmd}} >"$tmp" 2>&1; then
      rm "$tmp"
      echo $'\n✅ {{description}}'
    else
      bat "$tmp"
      rm "$tmp"
      exit 1
    fi

# Upgrade homebrew dependencies, nvim plugins, Treesitter parsers, Mason packages, tmux plugins and global pnpm packages
upgrade:
  @{{just_executable()}} --justfile {{justfile()}} _run-and-report "brew update && brew upgrade -y && brew cleanup" "Homebrew dependencies updated"
  @{{just_executable()}} --justfile {{justfile()}} _run-and-report "nvim --headless -c 'lua vim.pack.update(nil, { force = true })' -c 'qa'" "Neovim plugins updated"
  @{{just_executable()}} --justfile {{justfile()}} _run-and-report """nvim --headless -c 'lua if not require("utils").treesitter_update_all() then vim.cmd.cquit() end' -c 'qa'""" "Treesitter parsers updated"
  @{{just_executable()}} --justfile {{justfile()}} _run-and-report """nvim --headless -c 'lua if not require("utils").mason_update_all() then vim.cmd.cquit() end' -c 'qa'""" "Mason packages updated"
  @{{just_executable()}} --justfile {{justfile()}} _run-and-report "~/.config/tmux/plugins/tpm/bin/update_plugins all 2>&1 | awk '{ print } /update fail/ { failed = 1 } END { exit failed }'" "Tmux plugins updated"
  @{{just_executable()}} --justfile {{justfile()}} _run-and-report "pnpm update -g --latest" "Global pnpm packages updated"


# Restore tmux sessions from last save (tmux-resurrect)
restore:
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp)
    {
      tmux kill-server 2>/dev/null || true
      tmux new-session -d -s restore-temp
      tmux run-shell "~/.config/tmux/plugins/tmux-resurrect/scripts/restore.sh"
    } >"$tmp" 2>&1 || { bat "$tmp"; rm "$tmp"; exit 1; }
    rm "$tmp"
    echo "✅ Tmux sessions restored"

# Synchronize notes and tasks
sync:
  @{{just_executable()}} --justfile {{justfile()}} _run-and-report "zk sync" "Notes synchronized"

# Add a timestamped entry to $NOTES/JOURNAL.md (creates today's date heading if missing)
note *note:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${NOTES:?NOTES env var not set}"
    file="$NOTES/JOURNAL.md"
    note="{{note}}"
    if [ -z "$note" ]; then
      printf "Note: "
      read -r note
    fi
    [ -z "$note" ] && { echo "✗ Empty note, aborting"; exit 1; }
    today="## $(date +%Y-%m-%d)"
    entry="- $(date +%H:%M): $note"
    if ! grep -qF "$today" "$file" 2>/dev/null; then
      printf '\n%s\n\n%s\n' "$today" "$entry" >> "$file"
    else
      printf '%s\n' "$entry" >> "$file"
    fi
    echo "✅ Added to JOURNAL.md: $entry"

# Start the XpDroid UI debugging environment in tmux
xpdroid-debug:
    tmux send-keys 'cd /Users/ineichep/Work/XpDroid/Unit.UI/UI/Source/XpDroid && pnpm start' Enter
    tmux split-window -v
    tmux send-keys 'start_api' Enter
    sleep 5
    tmux split-window -v
    tmux send-keys 'suppress_notifications; exit' Enter

# Quick/safe cleanup (no sudo)
clean:
    #!/usr/bin/env bash
    rm -rf ~/Library/Caches/* ~/Library/Logs/* ~/.Trash/* /tmp/*
    echo "✅ Quick cleanup done!"
